{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "adico registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "namespace", "name", "compatibility", "items"],
  "properties": {
    "formatVersion": { "const": 1 },
    "namespace": { "type": "string", "pattern": "^@[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "compatibility": { "$ref": "#/definitions/compatibility" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli"],
      "properties": {
        "cli": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "files"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": {
          "enum": [
            "registry:ui", "registry:component", "registry:hook", "registry:lib",
            "registry:block", "registry:page", "registry:theme", "registry:file", "registry:template"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/file" }
        },
        "registryDependencies": { "type": "array", "items": { "type": "string" } },
        "cargoDependencies": { "type": "array", "items": { "$ref": "#/definitions/cargoDependency" } },
        "style": { "$ref": "#/definitions/style" },
        "moduleExports": { "type": "array", "items": { "$ref": "#/definitions/moduleExport" } },
        "documentation": { "$ref": "#/definitions/documentation" },
        "compatibility": { "$ref": "#/definitions/compatibility" },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "targetRoot", "target", "checksum"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "targetRoot": { "enum": ["ui", "components", "lib", "hooks", "css"] },
        "target": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "cargoDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crate", "version"],
      "properties": {
        "crate": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "items": { "type": "string" } },
        "defaultFeatures": { "type": "boolean" },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticTokens": { "type": "boolean" },
        "radiusToken": { "type": "boolean" },
        "utilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "moduleExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRoot", "module"],
      "properties": {
        "targetRoot": { "enum": ["ui", "components", "lib", "hooks", "css"] },
        "module": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "reexport": { "type": "boolean" }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "compositionNote": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record"],
      "properties": {
        "record": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    }
  }
}
