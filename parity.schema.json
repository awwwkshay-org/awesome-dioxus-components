{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "adico component parity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalog", "components"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["pending_inventory", "tracked"]
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "refreshedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "tracked"
              }
            }
          },
          "then": {
            "required": ["source", "revision", "refreshedAt"]
          }
        }
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/component"
      }
    }
  },
  "definitions": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "passed", "evidence"],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicable": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "passed": {
                "const": false
              }
            },
            "required": ["note"]
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "registryItem", "dimensions"],
      "properties": {
        "status": {
          "enum": ["missing", "in_progress", "complete", "not_applicable"]
        },
        "registryItem": {
          "type": ["string", "null"]
        },
        "intentionalDeviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "api",
            "visual",
            "variants",
            "states",
            "keyboard",
            "accessibility",
            "darkMode",
            "rtl",
            "responsive",
            "examples",
            "cli",
            "cargo",
            "web",
            "desktop",
            "ssrHydration",
            "docs"
          ],
          "properties": {
            "source": { "$ref": "#/definitions/dimension" },
            "api": { "$ref": "#/definitions/dimension" },
            "visual": { "$ref": "#/definitions/dimension" },
            "variants": { "$ref": "#/definitions/dimension" },
            "states": { "$ref": "#/definitions/dimension" },
            "keyboard": { "$ref": "#/definitions/dimension" },
            "accessibility": { "$ref": "#/definitions/dimension" },
            "darkMode": { "$ref": "#/definitions/dimension" },
            "rtl": { "$ref": "#/definitions/dimension" },
            "responsive": { "$ref": "#/definitions/dimension" },
            "examples": { "$ref": "#/definitions/dimension" },
            "cli": { "$ref": "#/definitions/dimension" },
            "cargo": { "$ref": "#/definitions/dimension" },
            "web": { "$ref": "#/definitions/dimension" },
            "desktop": { "$ref": "#/definitions/dimension" },
            "ssrHydration": { "$ref": "#/definitions/dimension" },
            "docs": { "$ref": "#/definitions/dimension" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "registryItem": {
                "type": "string",
                "minLength": 1
              },
              "dimensions": {
                "type": "object",
                "properties": {
                  "source": { "$ref": "#/definitions/passedDimension" },
                  "api": { "$ref": "#/definitions/passedDimension" },
                  "visual": { "$ref": "#/definitions/passedDimension" },
                  "variants": { "$ref": "#/definitions/passedDimension" },
                  "states": { "$ref": "#/definitions/passedDimension" },
                  "keyboard": { "$ref": "#/definitions/passedDimension" },
                  "accessibility": { "$ref": "#/definitions/passedDimension" },
                  "darkMode": { "$ref": "#/definitions/passedDimension" },
                  "rtl": { "$ref": "#/definitions/passedDimension" },
                  "responsive": { "$ref": "#/definitions/passedDimension" },
                  "examples": { "$ref": "#/definitions/passedDimension" },
                  "cli": { "$ref": "#/definitions/passedDimension" },
                  "cargo": { "$ref": "#/definitions/passedDimension" },
                  "web": { "$ref": "#/definitions/passedDimension" },
                  "desktop": { "$ref": "#/definitions/passedDimension" },
                  "ssrHydration": { "$ref": "#/definitions/passedDimension" },
                  "docs": { "$ref": "#/definitions/passedDimension" }
                }
              }
            }
          }
        }
      ]
    },
    "passedDimension": {
      "allOf": [
        { "$ref": "#/definitions/dimension" },
        {
          "type": "object",
          "properties": {
            "applicable": { "const": true },
            "passed": { "const": true }
          }
        }
      ]
    }
  }
}
