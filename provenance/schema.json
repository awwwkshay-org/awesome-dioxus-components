{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "adico source provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "upstream",
    "revision",
    "license",
    "importedAt",
    "originalPaths",
    "localPaths",
    "changes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "upstream": {
      "type": "string",
      "format": "uri"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "license": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "importedAt": {
      "type": "string",
      "format": "date"
    },
    "originalPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "localPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "summary"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "upstreamReference": {
            "type": "string"
          }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
