{
  "$schema": "https://adico.dev/schema/components.json/v1",
  "version": 1,
  "style": "default",
  "theme": {
    "tokens": "shadcn",
    "darkMode": "class"
  },
  "paths": {
    "components": "src/components",
    "ui": "src/components/ui",
    "lib": "src/adico_lib",
    "hooks": "src/hooks"
  },
  "css": {
    "entry": "assets/tailwind.css",
    "framework": "tailwind"
  },
  "registries": {
    "@adico": {
      "kind": "embedded"
    }
  },
  "defaultRegistry": "@adico"
}
