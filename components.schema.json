{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "adico components.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "style", "theme", "paths", "css", "registries", "defaultRegistry"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "style": { "type": "string", "minLength": 1 },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "darkMode"],
      "properties": {
        "tokens": { "type": "string", "minLength": 1 },
        "darkMode": { "type": "string", "minLength": 1 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "ui", "lib", "hooks"],
      "properties": {
        "components": { "type": "string", "minLength": 1 },
        "ui": { "type": "string", "minLength": 1 },
        "lib": { "type": "string", "minLength": 1 },
        "hooks": { "type": "string", "minLength": 1 }
      }
    },
    "css": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "framework"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 }
      }
    },
    "registries": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^@[a-z0-9-]+$": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "embedded" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "local" }, "path": { "type": "string", "minLength": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": { "kind": { "const": "https" }, "url": { "type": "string", "format": "uri" } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "defaultRegistry": { "type": "string", "pattern": "^@[a-z0-9-]+$" }
  }
}
